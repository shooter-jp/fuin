{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM"],
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2023",
    "paths": {
      "@fuin/chain": ["packages/chain/src/index.ts"],
      "@fuin/core": ["packages/core/src/index.ts"],
      "@fuin/mcp": ["packages/mcp/src/index.ts"]
    },
    "types": ["node"]
  }
}
