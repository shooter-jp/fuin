{
  "name": "fuin-wallet-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @fuin/core build && pnpm --filter @fuin/chain build && pnpm --filter @fuin/mcp build && pnpm --filter @fuin/ui build && pnpm --filter @fuin/wallet build",
    "dev": "pnpm --filter @fuin/ui dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^5.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
